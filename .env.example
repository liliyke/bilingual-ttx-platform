# Supabase (Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Used by the TTX-Architect tooling, not by the web app at runtime
ANTHROPIC_API_KEY=

# App
NEXT_PUBLIC_APP_NAME="TTX Platform"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Locales — French is the default
NEXT_PUBLIC_DEFAULT_LOCALE=fr-CA
NEXT_PUBLIC_SUPPORTED_LOCALES=fr-CA,en-CA
